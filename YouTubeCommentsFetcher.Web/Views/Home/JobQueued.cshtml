@model JobQueuedViewModel
@{
    ViewData["Title"] = "Обработка запроса";
}
<h2>Запрос поставлен в очередь</h2>
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Warning"]</div>
}
<p>Идентификатор задачи: <strong>@Model.JobId</strong></p>
<div style="margin-top:20px;">
    <label for="progress">Прогресс:</label>
    <progress id="progress"
              value="0"
              max="100"
              style="width: 100%; height: 24px;">
    </progress>
    <div id="progress-text"
         style="text-align: center; margin-top: 5px;">
        0%
    </div>
</div>

<p id="statusText" aria-live="polite">Ожидание завершения фоновой задачи...</p>

<div id="statusAlert" class="alert d-none" role="alert"></div>

<a id="openResult"
   class="btn btn-primary d-none"
   href="@Url.Action("LoadData", "Home", new { jobId = Model.JobId })">
    Открыть собранные комментарии
</a>

<script>
    const jobId = '@Model.JobId';
    const jsonUrl = '@Model.DataFileUrl';
    const progressBar = document.getElementById("progress");
    const progressText = document.getElementById("progress-text");
    const statusText = document.getElementById("statusText");
    const statusAlert = document.getElementById("statusAlert");
    const openResult = document.getElementById("openResult");
    const statusUrl = `/Home/GetJobStatus?jobId=${jobId}`;

    function showFinalState(alertClass, title, message) {
        statusText.textContent = title;
        statusAlert.textContent = message;
        statusAlert.classList.remove("d-none");
        statusAlert.classList.add(alertClass);
    }

    async function update() {
        try {
            const response = await fetch(statusUrl);
            const status = await response.json();

            progressBar.value = status.progress;
            progressText.innerText = `${status.progress}%`;

            if (status.failed) {
                showFinalState("alert-danger", "Сбор не удался.", status.message);
            } else if (status.completed && status.incomplete) {
                showFinalState("alert-warning", "Сбор остановлен досрочно.", status.message);
                openResult.classList.remove("d-none");
            } else if (status.completed) {
                const blob = await fetch(jsonUrl).then(x => x.blob());
                const file = new File([blob], '@Model.FileName', { type: 'application/json' });
                const formData = new FormData();
                formData.append('jsonFile', file);
                window.location.href = `/Home/LoadData?jobId=${jobId}`;
            } else {
                setTimeout(update, 2000);
            }
        } catch {
            setTimeout(update, 5000);
        }
    }

    update();
</script>
